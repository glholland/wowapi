# Copy to .env (task setup does this) and fill in. .env is git-ignored.
# Create API credentials at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Optional
# retail (default) or forever (World of Warcraft: Forever)
WOW_GAME=retail
WOW_REGION=us
WOW_LOCALE=en_US
WOW_REALM=
WOW_CHARACTER=
